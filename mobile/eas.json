{
  "cli": {
    "version": ">= 21.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:8090/api/v1",
        "EXPO_PUBLIC_JAMBO_VARIANT": "direct",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jambofilms.com/api/v1",
        "EXPO_PUBLIC_JAMBO_VARIANT": "direct",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID"
      }
    },
    "preview-play": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jambofilms.com/api/v1",
        "EXPO_PUBLIC_JAMBO_VARIANT": "play",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID"
      }
    },
    "production-direct": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jambofilms.com/api/v1",
        "EXPO_PUBLIC_JAMBO_VARIANT": "direct",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID"
      }
    },
    "production-play": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jambofilms.com/api/v1",
        "EXPO_PUBLIC_JAMBO_VARIANT": "play",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "$GOOGLE_ANDROID_CLIENT_ID",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "$GOOGLE_WEB_CLIENT_ID"
      }
    }
  },
  "submit": {
    "production-play": {}
  }
}
